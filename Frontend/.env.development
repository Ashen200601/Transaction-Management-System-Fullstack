# Local development. The app calls /api on its own origin and the Vite dev server
# forwards those calls to the backend at API_PROXY_TARGET (start it as in
# Backend/README.md). An in-browser mock API (MSW) answers every module except the
# ones in VITE_MOCKS_EXCEPT, which reach the real backend.
# Sign-in is real: create an account on the sign-up page. To work without the
# backend, empty VITE_MOCKS_EXCEPT and use the demo sign-in in
# src/mocks/handlers/auth.ts. No secrets belong in this file.
VITE_API_BASE_URL=/api
VITE_ENABLE_MOCKS=true
# Add a module as soon as the backend implements it, e.g. auth,businesses
VITE_MOCKS_EXCEPT=auth
# Dev server only: where /api requests are forwarded.
API_PROXY_TARGET=http://localhost:8080

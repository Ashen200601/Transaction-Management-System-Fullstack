# Copy to .env.local (or .env.production for builds) and fill in.

# Absolute URL of the backend API, e.g. https://api.example.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# "oidc" (default) signs in through your identity provider.
# "mock" signs in a demo user without a password. Development only:
# production builds refuse to start with mock auth.
VITE_AUTH_MODE=oidc

# Required when VITE_AUTH_MODE=oidc
VITE_OIDC_AUTHORITY=https://auth.example.com/realms/finovex
VITE_OIDC_CLIENT_ID=finovex-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# "true" serves the API from in-browser mocks instead of VITE_API_BASE_URL.
VITE_ENABLE_MOCKS=false

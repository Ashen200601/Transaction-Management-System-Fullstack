# Copy to .env.local (or .env.production for builds) and fill in.

# Where the backend API is: an absolute URL such as https://api.example.com/api, or a
# path on the site serving the app, such as /api (behind a reverse proxy, or the
# dev server's proxy below). Users sign in through POST {API}/auth/login.
VITE_API_BASE_URL=http://localhost:8080/api

# "true" serves the API from in-browser mocks instead of VITE_API_BASE_URL,
# including a demo sign-in. Development only: production builds refuse to start with it.
VITE_ENABLE_MOCKS=false

# With mocks on: comma-separated API modules that skip the mocks and use the real API.
# A module is the first path segment, e.g. "auth" covers /auth/login and /auth/signup.
VITE_MOCKS_EXCEPT=

# Dev server only: when set, `npm run dev` forwards /api requests to this backend.
# Pair it with VITE_API_BASE_URL=/api.
API_PROXY_TARGET=
